# IndepenSense secrets — copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is committed. `config.py` loads
# `.env` into the environment on import, so this works for the systemd
# service and for manual tests run over SSH alike. A variable already
# set in the real environment takes precedence, so you can still
# override for a single run:
#
#     INDEPENSENSE_CLOUD_API_KEY=other-key python -m indepensense.app
#
# Format: one KEY=value per line. `#` comments and blank lines ignored.
# No interpolation, no multi-line values.

# Mistral API key, for the cloud LLM fallback on unknown intents.
# Get one at https://console.mistral.ai/. Leaving this empty is fine —
# the wearable then answers unknown utterances locally and says so once
# at startup.
INDEPENSENSE_CLOUD_API_KEY=
