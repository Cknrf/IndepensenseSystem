[Unit]
Description=Pre-load NLU model into Ollama on boot (IndepenSense)
Documentation=https://github.com/cknrf/IndepensenseSystem
After=ollama.service
Requires=ollama.service

[Service]
Type=oneshot
User=cknrf
Group=cknrf
WorkingDirectory=/home/cknrf/Desktop/thesis/IndepensenseSystem
# `Type=oneshot` disables the start timeout by default, and the tool's
# catalogue wait used to be an unbounded `until` loop. Together that
# meant a model which never appeared left this unit "starting" forever
# — and when `indepensense.service` was ordered `After=` this one, the
# wearable never started either. Observed: a missing model held this
# unit for five hours with no error.
#
# Past this, fail and let the wearable carry on: it re-warms the model
# itself at the end of its own load, so a failure here costs the user
# that time, not the voice interface.
#
# This budget covers the WHOLE unit start — waiting for the model to be
# catalogued plus loading and prefilling it — so it must exceed the
# tool's own waits (60 s catalogue + NLU_WARMUP_TIMEOUT_S, 90 s for the
# 1.7B model) or systemd kills the tool while it still believes it has
# time, which reads as a mysterious truncation rather than a timeout.
TimeoutStartSec=240
# The tool, not a shell script with curl: it sends the parser's own
# warmup request, so the system-prompt prefix Ollama caches is the one
# every real query reuses. The model name comes from `config.NLU_MODEL`
# the same way — see the tool's docstring.
ExecStart=/home/cknrf/Desktop/thesis/IndepensenseSystem/.venv/bin/python -m indepensense.tools.warm_nlu
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
