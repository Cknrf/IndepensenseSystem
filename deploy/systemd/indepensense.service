[Unit]
Description=IndepenSense wearable runtime
Documentation=https://github.com/cknrf/IndepensenseSystem
Wants=network-online.target
# Deliberately NOT ordered after `ollama-warmup.service`.
#
# That unit is `Type=oneshot`, which means systemd treats it as started
# only when its script *exits* — and that script waits up to 60 s for
# Ollama to catalogue the model, then up to 120 s pinning it in RAM. An
# `After=` on it therefore held the whole wearable behind a model load,
# on top of the Pi's own boot.
#
# The cost is not the delay itself but what the delay is in front of.
# `start()` opens by playing the "IndepenSense is starting up, this takes
# about two minutes" clip — the one thing that tells a user who cannot
# see a screen that the device is alive. Every second queued here is a
# second of silence indistinguishable from a device that failed to power
# on, which is precisely what that message exists to prevent.
#
# Nothing is lost by starting earlier. The app warms the NLU itself on a
# background thread (`_warm_up_nlu`) and holds the "ready" greeting until
# that finishes, so the user is still told when voice commands work. The
# warmup unit keeps running in parallel — it is `WantedBy=multi-user.target`
# in its own right — it just no longer gates anything.
#
# `graphhopper` and `photon` stay in `After=` and cost nothing: both are
# `Type=simple`, so systemd calls them started the moment java is exec'd
# and never waits for the graph or the index to load.
After=network-online.target ollama.service graphhopper.service photon.service
# `Wants=`, not `Requires=`. Ordering only — a failure in any of these
# must not keep the wearable off.
#
# Under `Requires=`, a GraphHopper that failed to start took the whole
# device with it: no fall detection, no obstacle warnings, no emergency
# button, because the routing engine was unhappy. That is the wrong
# trade for a safety device. Routing, geocoding and voice are features;
# noticing that the wearer has fallen over is the reason it exists.
#
# Safe because nothing here is touched during startup. `_open_router`
# and `_open_geocoder` only store a URL, and `_open_parser` constructs
# the Ollama client with `warmup=False` precisely so that `start()` does
# not block on the LLM. The first *request* to a dead service fails, and
# every caller already handles that — it is why the GraphHopper client
# reports the server's own error text.
#
# `Requires=` also propagated stops: `systemctl stop graphhopper` used to
# stop the wearable too. Nothing depends on that any more —
# `deploy/graphhopper/rebuild.sh` names `indepensense` explicitly.
Wants=ollama.service graphhopper.service photon.service

[Service]
Type=simple
User=cknrf
Group=cknrf
# Serial ports (GPS on ttyUSB1), I²C (MPU6050), and GPIO (buttons + buzzer + motors).
SupplementaryGroups=dialout i2c gpio
WorkingDirectory=/home/cknrf/Desktop/thesis/IndepensenseSystem
Environment="PYTHONUNBUFFERED=1"
# Where PipeWire's socket lives. Without this the wearable starts, reads
# every sensor, classifies every command — and is completely silent,
# because `sounddevice` and `wpctl` both look for `$XDG_RUNTIME_DIR/pipewire-0`
# and a system service inherits no session environment. Running the app by
# hand hides the problem: a login shell already has this set.
#
# The UID is written out in full. `%U` was used here on the belief that it
# expands to the UID of `User=` above; in this systemd it expands to **0**,
# the UID of the manager running the unit. The service therefore ran with
# XDG_RUNTIME_DIR=/run/user/0 — root's runtime directory, which holds no
# PipeWire socket for cknrf.
#
# The failure that caused is worth recording, because none of it mentions
# the environment. The ALSA PipeWire plugin could not connect, so ALSA
# stopped offering `pipewire`, `pulse` and `default`: the process saw 14
# PCMs instead of 17. PortAudio then fell back to index 0, the raw USB
# headset, which does not resample — so every 16 kHz stream died with
# `Invalid sample rate [PaErrorCode -9997]` while PipeWire sat healthy and
# unused, and `wpctl` silently failed for the same reason. The wearable
# booted, read every sensor and answered every button, in total silence.
#
# If the account ever changes, change this number. That is worse than a
# specifier that worked, and better than one that looks right and is not:
# `id -u cknrf` must equal 1000.
#
# It is only half the fix — the directory exists only while that user has a
# session. See `loginctl enable-linger` in this directory's README.
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=/home/cknrf/Desktop/thesis/IndepensenseSystem/.venv/bin/python -m indepensense.app
Restart=on-failure
RestartSec=5
# Graceful shutdown: SIGTERM triggers app.stop() which drains the telemetry
# queue (up to 5 s), stops the heartbeat sender, and closes sensors. The
# 15 s ceiling is comfortably above the worst-case drain.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
