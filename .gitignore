# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
dist/

# Secrets — API keys live here, loaded by config.py on import.
# NEVER commit this. `.env.example` is the committed template.
.env

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Local logs and data
*.log
data/

# Runtime state written by the device (guardian contact cache, GPS surveys).
# Machine-local and regenerated — never committed.
#
# `var/*` rather than `var/`: git never descends into an excluded
# directory, so a `!` negation below it is silently ignored. Excluding
# the *contents* is what leaves room for the exception.
var/*
gps_survey.csv

# ...except the fall-detection traces, which are the opposite of
# regenerable: each one cost someone an actual fall onto a mattress.
# They are the evidence behind the detector's sensitivity and specificity
# figures, they are small CSVs, and a threshold changed a year from now
# has to be re-verified against the same recordings. Losing the SD card
# would mean falling over again to reproduce a thesis result.
!var/traces/
var/traces/*
!var/traces/*.csv

# ML model weights (large binaries, downloaded on first run)
models/
*.pt
*.onnx
